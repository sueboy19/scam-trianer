# ============================================
# 詐騙訓練網站 - 環境變數範本
# ============================================
# 本機開發：複製成 .env 並填入自己的值
# 正式部署：在 Coolify UI 的 Environment Variables 設定

# ---- 後端 ----
NODE_ENV=development
PORT=3000
# SQLite 檔案路徑（本機開發用專案內相對路徑；正式部署用 /app/data/app.db）
DB_PATH=./data/app.db

# ---- Better Auth ----
# 用 `openssl rand -base64 32` 產生一組隨機字串
BETTER_AUTH_SECRET=change-me-to-a-random-secret
# Better Auth 的基底 URL（本機開發 = API 網址；正式 = 你的網域）
BETTER_AUTH_URL=http://localhost:3000
# 前端網址（用於 OAuth callback 後導回）
CLIENT_URL=http://localhost:5173

# ---- Google OAuth ----
# 申請：https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI 填：${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Facebook OAuth ----
# 申請：https://developers.facebook.com/ → My Apps → Facebook Login
# Valid OAuth Redirect URI 填：${BETTER_AUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- LINE Login ----
# 申請：https://developers.line.biz/ → LINE Login（Web App 類型）
# Redirect URI 填：${BETTER_AUTH_URL}/api/auth/callback/line
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ---- Instagram (via Meta) ----
# 透過 Meta for Developers 的「Instagram API with Instagram Login」
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
